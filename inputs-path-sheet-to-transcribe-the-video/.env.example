# Backend
ADMIN_PASSWORD=your-secure-password
SECRET_KEY=change-this-to-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
OPENAI_API_KEY=
WHISPER_MODEL=medium
FFMPEG_LOCATION=
FRONTEND_URL=http://localhost:3000
DATA_DIR=./data

# Input queue Google Sheet (video links)
INPUT_SHEET_URL=

# Output results Google Sheet (different spreadsheet)
OUTPUT_SHEET_URL=

# Optional AI for category + British/American variants
DESCRIPTION_PROVIDER=auto
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Parallel batch workers (1–8)
BATCH_WORKERS=3

# ElevenLabs voice cloning
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
VOICE_OUTPUT_DIR=./data/voices_output

# Optional: Google Cloud Translate API (else free deep-translator)
# GOOGLE_TRANSLATE_API_KEY=
# GOOGLE_TRANSLATE_MODE=auto

# Frontend (copy to frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
