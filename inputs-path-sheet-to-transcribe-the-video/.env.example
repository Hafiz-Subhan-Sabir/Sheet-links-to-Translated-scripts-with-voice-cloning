# Backend
ADMIN_PASSWORD=your-secure-password
SECRET_KEY=change-this-to-a-long-random-string

# Google OAuth (one Gmail account is enough)
# 1) Google Cloud Console → APIs & Services → Credentials → Create OAuth client (Web)
# 2) Authorized redirect URI: http://localhost:8000/api/auth/google/callback
# 3) OAuth consent screen → External → add yourself as Test user
# 4) Enable: Google Sheets API, Google Docs API, Google Drive API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000

# OpenAI — full transcription only (Whisper cloud)
OPENAI_API_KEY=
WHISPER_ENGINE=openai
DESCRIPTION_PROVIDER=off
OPENAI_MODEL=gpt-4o-mini
WHISPER_MODEL=medium
FFMPEG_LOCATION=
DATA_DIR=./data

# Input / output Google Sheets
INPUT_SHEET_URL=
OUTPUT_SHEET_URL=

# Parallel batch workers (1–8)
BATCH_WORKERS=3

# Fish Audio voice cloning (use s2.1-pro-free for $0 developer TTS)
FISH_API_KEY=
FISH_MODEL=s2.1-pro-free
VOICE_OUTPUT_DIR=./data/voices_output

# Optional: Google Cloud Translate API (else free deep-translator)
# GOOGLE_TRANSLATE_API_KEY=
# GOOGLE_TRANSLATE_MODE=auto

# Frontend (copy to frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
